# API port (the Angular dev proxy expects 3000)
PORT=3000

# SQLite file. Default: apps/api/data/alerts.db
# DB_PATH=

# Optional SMTP for real email (A10). Without SMTP_HOST, email is log-only and
# every message is still viewable through its preview link.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=World Alerts <alerts@example.com>
